# firmware/rx — ESP-IDF v5.5.6, target esp32
# esp-csi/examples/get-started/csi_recv/sdkconfig.defaults 그대로 + FREERTOS_HZ=1000
CONFIG_PARTITION_TABLE_OFFSET=0xa000
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=128
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_FREERTOS_HZ=1000

# 시리얼 콘솔 (idf.py monitor 도 이 값을 따라감)
# 921600 + TX 50Hz: 전체 CSI(한 줄 약 1.3KB) × 50Hz ≈ 0.66Mbps → 921600의 약 71%.
# 2M은 PC 수신에서 바이트가 빠져 CSI 행 약 11%가 손상됨(2026-11-13 실측), 921600은 0.08%.
# 100Hz로 되돌리면 921600으로는 대역폭이 부족하다(firmware/rx/README.md 참고). 로거 기본값도 921600.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
